{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scan Station",
  "version": "0.1.0",
  "identifier": "xyz.themissing.scanstation",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Scan Station",
        "width": 960,
        "height": 544,
        "resizable": true,
        "fullscreen": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
